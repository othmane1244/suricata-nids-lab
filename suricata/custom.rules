# ============================================================
# custom.rules — Règles Suricata personnalisées
# CodeAlpha Cybersecurity Internship — Task 4: NIDS
# ============================================================
#
# À placer dans /etc/suricata/rules/custom.rules puis référencer
# dans suricata.yaml sous "rule-files:".
#
# SID range utilisée : 1000001-1000010 (range locale, ne collisionne
# pas avec les règles officielles Emerging Threats / ET Open).

# ------------------------------------------------------------
# 1. Détection de scan de ports (style Nmap -sS / -sT)
# Plus de 20 SYN vers des ports différents depuis la même IP
# source en moins de 10 secondes.
# ------------------------------------------------------------
alert tcp any any -> $HOME_NET any ( \
    msg:"NIDS - Possible TCP Port Scan Detected (Nmap-like)"; \
    flags:S; \
    threshold:type both, track by_src, count 20, seconds 10; \
    classtype:attempted-recon; \
    sid:1000001; rev:1; \
)

# ------------------------------------------------------------
# 2. Détection de scan furtif (Nmap -sN / -sF / -sX, flags nuls ou exotiques)
# ------------------------------------------------------------
alert tcp any any -> $HOME_NET any ( \
    msg:"NIDS - Stealth Scan Detected (NULL/FIN/Xmas flags)"; \
    flags:0; \
    threshold:type both, track by_src, count 10, seconds 10; \
    classtype:attempted-recon; \
    sid:1000002; rev:1; \
)

# ------------------------------------------------------------
# 3. Brute force SSH — trop de tentatives de connexion vers le port 22
# depuis la même source en peu de temps (signature Hydra/Medusa/manual)
# ------------------------------------------------------------
alert tcp any any -> $HOME_NET 22 ( \
    msg:"NIDS - SSH Brute Force Attempt Detected"; \
    flow:to_server; \
    flags:S; \
    threshold:type threshold, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; \
    sid:1000003; rev:1; \
)

# ------------------------------------------------------------
# 4. Flood ICMP (ping flood / DoS basique)
# ------------------------------------------------------------
alert icmp any any -> $HOME_NET any ( \
    msg:"NIDS - ICMP Flood Detected (possible DoS)"; \
    itype:8; \
    threshold:type both, track by_src, count 50, seconds 5; \
    classtype:denial-of-service; \
    sid:1000004; rev:1; \
)

# ------------------------------------------------------------
# 5. User-Agent suspect dans les requêtes HTTP (outils de scan/recon)
# ------------------------------------------------------------
alert http any any -> $HOME_NET any ( \
    msg:"NIDS - Suspicious User-Agent (Scanning Tool)"; \
    flow:to_server,established; \
    http.user_agent; \
    content:"Nmap"; nocase; \
    classtype:attempted-recon; \
    sid:1000005; rev:1; \
)

alert http any any -> $HOME_NET any ( \
    msg:"NIDS - Suspicious User-Agent (curl/wget automated tool)"; \
    flow:to_server,established; \
    http.user_agent; \
    pcre:"/^(curl|Wget|python-requests)/i"; \
    classtype:attempted-recon; \
    sid:1000006; rev:1; \
)

# ------------------------------------------------------------
# 6. Brute force générique sur un service web (login form spam)
# Beaucoup de POST vers la même URI depuis la même source
# ------------------------------------------------------------
alert http any any -> $HOME_NET any ( \
    msg:"NIDS - Possible Web Login Brute Force"; \
    flow:to_server,established; \
    http.method; content:"POST"; \
    threshold:type threshold, track by_src, count 15, seconds 60; \
    classtype:attempted-admin; \
    sid:1000007; rev:1; \
)

# ------------------------------------------------------------
# 7. Tentative d'accès FTP anonyme (souvent un premier pas de recon)
# ------------------------------------------------------------
alert tcp any any -> $HOME_NET 21 ( \
    msg:"NIDS - FTP Anonymous Login Attempt"; \
    flow:to_server,established; \
    content:"USER anonymous"; nocase; \
    classtype:attempted-recon; \
    sid:1000008; rev:1; \
)

# ------------------------------------------------------------
# 8. Transfert de fichier suspect (.exe / .sh) sur un port non standard
# ------------------------------------------------------------
alert tcp any any -> $HOME_NET any ( \
    msg:"NIDS - Suspicious Executable Transfer Detected"; \
    flow:to_server,established; \
    file_data; \
    content:"MZ"; offset:0; depth:2; \
    classtype:policy-violation; \
    sid:1000009; rev:1; \
)

# ------------------------------------------------------------
# 9. Volume anormal de trafic ARP (scan ARP / possible ARP spoofing)
# Suricata n'a pas de protocole "arp" dédié dans le langage de règles ;
# on détecte le type Ethernet 0x0806 (ARP) via ether.hdr + content.
#
# ⚠️ Règle la plus expérimentale du fichier : le tracking "by_src" du
# threshold s'appuie normalement sur l'adresse IP, qui n'existe pas
# forcément au niveau Ethernet/ARP. À tester en conditions réelles —
# si le seuillage ne se déclenche pas correctement, retirer le
# threshold et observer juste le volume brut d'alertes "ARP packet",
# ou compléter avec un script externe type arpwatch/arp-scan.
# ------------------------------------------------------------
# DÉSACTIVÉE : Suricata 7.0.3 refuse cette règle (« error parsing signature » :
# protocole "ether" / mot-clé ether.hdr non reconnus), ce qui fait échouer
# `suricata -T` pour tout le fichier. Conservée en commentaire comme piste ;
# à réécrire et valider avant de la réactiver.
# alert ether any any -> any any ( \
#     msg:"NIDS - Abnormal ARP Traffic Volume (possible ARP scan/spoofing)"; \
#     ether.hdr; \
#     content:"|08 06|"; offset:12; depth:2; \
#     threshold:type both, track by_src, count 30, seconds 10; \
#     sid:1000010; rev:1; \
# )
